{
  "manifest_version": 3,
  "name": "Web Audio EQ (all sites)",
  "version": "1.1.0",
  "description": "13-band graphic EQ + bass/mid/treble/preamp for any website's audio & video. Re-applies on every track change so settings never reset.",
  "permissions": ["storage"],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Audio EQ"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
